{
  "name": "cogit",
  "version": "0.3.4",
  "private": true,
  "description": "Blazing-fast Git GUI client for power users",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "check": "npm run check -w frontend",
    "test": "npm run test -w frontend",
    "tauri": "tauri",
    "bench:repos": "node scripts/bench/fixtures.mjs",
    "bench:build": "node scripts/bench/build.mjs",
    "bench": "node scripts/bench/run.mjs",
    "agent": "node scripts/build-agent.mjs",
    "release": "node scripts/build-agent.mjs --release"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
