#!/usr/bin/env bash
# The checks a commit does not pay for: clippy over every target, and the frontend type
# check. Tests are deliberately not here — see the note below.
#
# Bypass deliberately with `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

say()  { printf '\033[36m[pre-push]\033[0m %s\n' "$1"; }
warn() { printf '\033[33m[pre-push]\033[0m %s\n' "$1"; }
fail() { printf '\033[31m[pre-push] %s\033[0m\n' "$1" >&2; exit 1; }

add_path() {
  if [ -d "$1" ]; then
    case ":$PATH:" in
      *":$1:"*) ;;
      *) PATH="$1:$PATH" ;;
    esac
  fi
}

add_path "$HOME/.cargo/bin"
add_path "${CARGO_HOME:-}/bin"
add_path "/c/Program Files/LLVM/bin"
add_path "/c/Program Files/nodejs"
add_path "/usr/local/bin"
export PATH

command -v cargo >/dev/null 2>&1 || fail "cargo not found; see doc/10-toolchain-setup.md"

# Nothing to push means nothing to verify: a delete or an already-current branch.
if ! read -r _local_ref _local_oid _remote_ref _remote_oid; then
  say "nothing to push"
  exit 0
fi

say "cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings || fail "clippy found problems"

# Tests do not run here. The timing tests need the machine to themselves, and sharing it
# with a build made them fail at random; a hook that cries wolf is a hook people learn to
# skip. They are run deliberately instead — the ones a change touches while the work goes
# on, and the whole suite once before it is handed over (doc/09-testing.md).
#
#   cargo nextest run --workspace --exclude cogit
#   npm --prefix frontend run test

if command -v npm >/dev/null 2>&1; then
  say "svelte-check"
  npm --prefix frontend run --silent check || fail "type check failed"
else
  warn "npm not found; the frontend was not verified"
fi

say "ok"
