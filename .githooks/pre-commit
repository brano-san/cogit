#!/usr/bin/env bash
# Cogit pre-commit checks. Enable once per clone:
#   git config core.hooksPath .githooks
#
# The budget is one minute. What costs more than it catches runs in pre-push instead:
# the whole test suite, and every test that asserts a duration (doc/09-testing.md).
#
# The hook fixes what it can (formatting, generated bindings) and re-stages the result.
# It only ever touches files that are already staged.
#
# Bypass deliberately with `git commit --no-verify`.
# Skip only the auto-fixing with COGIT_HOOK_NO_FIX=1.
# Apply clippy's machine-applicable suggestions with COGIT_HOOK_FIX=1 (adds ~30 s).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

say()  { printf '\033[36m[pre-commit]\033[0m %s\n' "$1"; }
warn() { printf '\033[33m[pre-commit]\033[0m %s\n' "$1"; }
fixed(){ printf '\033[32m[pre-commit]\033[0m %s\n' "$1"; }
fail() { printf '\033[31m[pre-commit] %s\033[0m\n' "$1" >&2; exit 1; }

BINDINGS=frontend/src/lib/ipc/bindings.ts

# What a commit is allowed to cost. Two kinds of test are left out and run in pre-push:
#
#   - tests that assert a duration, because thirty tests sharing a machine make the number
#     they measure meaningless;
#   - the integration suites that drive real git operations (clones, pushes, submodules,
#     rebases). They are the slowest third of the suite and they catch the kind of breakage
#     that matters before a push, not before every commit.
TIMING='binary(mutation_speed) | binary(performance) | binary(selection_speed) | test(/budget/) | test(one_enormous_line_does_not_hang_the_engine)'
HEAVY='binary(surgery) | binary(submodules) | binary(network) | binary(branch_ops) | binary(stashes) | binary(merging) | binary(rebasing) | binary(replay) | binary(upstream)'
FAST_ONLY="not ($TIMING | $HEAVY)"

# --- locate the toolchain ----------------------------------------------------
# GUI Git clients (SmartGit, Fork, IntelliJ, VS Code) run hooks with the environment
# they were launched with, so anything installed afterwards is missing from PATH.
# A hook that trusts the caller's PATH works in the terminal and fails in the GUI,
# which is the worst of both worlds — so find the tools ourselves.
add_path() {
  if [ -d "$1" ]; then
    case ":$PATH:" in
      *":$1:"*) ;;
      *) PATH="$1:$PATH" ;;
    esac
  fi
}

add_path "$HOME/.cargo/bin"
add_path "${CARGO_HOME:-}/bin"
add_path "/c/Program Files/LLVM/bin"          # lld-link, required by .cargo/config.toml
add_path "/c/Program Files/nodejs"
add_path "/usr/local/bin"
export PATH

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 not found in PATH.
               Install the toolchain as described in doc/10-toolchain-setup.md.
               If it is installed, your Git client was started before it was —
               restart the client so it picks up the current PATH."
}

# --- what is being committed -------------------------------------------------
mapfile -d '' -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ ${#STAGED[@]} -eq 0 ]; then
  say "nothing staged"
  exit 0
fi

# A here-string, not a pipe: `grep -q` exits on its first match, which would
# SIGPIPE the writer, and `pipefail` would then report the whole test as failed.
STAGED_LINES=$(printf '%s\n' "${STAGED[@]}")
has() { grep -qE "$1" <<<"$STAGED_LINES"; }
if has '\.rs$|Cargo\.(toml|lock)$';     then RUST=1; else RUST=0; fi
if has '^frontend/.*\.(ts|js|svelte)$'; then WEB=1;  else WEB=0;  fi

# Which crates the change can break: the ones touched, plus the ones that depend on them.
# `test_fixtures` is a dev-dependency of everything, so touching it means everything.
affected_packages() {
  local pkgs=() touched
  touched=$(grep -oE '^crates/[a-z_]+' <<<"$STAGED_LINES" | sed 's|crates/||' | sort -u)

  if grep -q '^test_fixtures$' <<<"$touched" || has '^Cargo\.(toml|lock)$'; then
    printf '%s' "--workspace --exclude cogit"
    return
  fi

  for name in $touched; do pkgs+=("-p" "$name"); done
  # Every engine crate is consumed by app_state; src-tauri is covered by the bindings run.
  if grep -qE '^(git_engine|diff_engine|graph_engine|fs_watcher)$' <<<"$touched"; then
    case " ${pkgs[*]} " in *" app_state "*) ;; *) pkgs+=("-p" "app_state") ;; esac
  fi
  if [ ${#pkgs[@]} -eq 0 ]; then
    printf '%s' "--workspace --exclude cogit"
  else
    printf '%s ' "${pkgs[@]}"
  fi
}

# --- may we rewrite files? ---------------------------------------------------
# A file that is staged *and* dirty in the worktree was partially staged with
# `git add -p`. Re-staging it after a rewrite would sweep in the very hunks the
# author deliberately held back, so auto-fixing is disabled for this commit.
mapfile -d '' -t PARTIAL < <(git diff --name-only -z -- "${STAGED[@]}")

FIX=1
if [ "${COGIT_HOOK_NO_FIX:-0}" = "1" ]; then FIX=0; fi
if [ ${#PARTIAL[@]} -gt 0 ]; then
  FIX=0
  warn "partially staged, so nothing will be rewritten automatically:"
  printf '               %s\n' "${PARTIAL[@]}"
  warn "commit them whole, or run the fixes yourself and stage the result."
fi

# Re-stages every staged path that the fixers changed, and reports them.
restage_changed() {
  local label=$1 changed=0 f
  for f in "${STAGED[@]}"; do
    if [ -e "$f" ] && ! git diff --quiet -- "$f"; then
      git add -- "$f"
      if [ "$changed" -eq 0 ]; then
        fixed "$label rewrote and re-staged:"
        changed=1
      fi
      printf '               %s\n' "$f"
    fi
  done
  return 0
}

# --- rust --------------------------------------------------------------------
if [ "$RUST" = "1" ]; then
  need cargo
  if [ "$FIX" = "1" ]; then
    say "cargo fmt"
    cargo fmt --all
    restage_changed "cargo fmt"
  else
    say "cargo fmt --check"
    cargo fmt --all --check || fail "formatting issues; run: cargo fmt --all"
  fi

  # `clippy --fix` costs half a minute and invalidates the cache for the run below, so it
  # is opt-in. The verifying run is the one that decides.
  if [ "${COGIT_HOOK_FIX:-0}" = "1" ] && [ "$FIX" = "1" ]; then
    say "cargo clippy --fix"
    if cargo clippy --fix --allow-staged --workspace --all-targets --quiet 2>/dev/null; then
      restage_changed "cargo clippy --fix"
    else
      warn "clippy could not auto-fix; the report below is authoritative"
    fi
  fi

  say "cargo clippy"
  cargo clippy --workspace --all-targets -- -D warnings || fail "clippy found problems"

  # nextest runs every test from every binary in one pool; `cargo test` runs the eighty
  # binaries one after another, which costs three times as long (doc/09-testing.md).
  read -r -a PKGS <<<"$(affected_packages)"
  say "tests ${PKGS[*]}"
  if command -v cargo-nextest >/dev/null 2>&1; then
    cargo nextest run "${PKGS[@]}" --profile quick -E "$FAST_ONLY" || fail "tests failed"
  else
    warn "cargo-nextest is not installed; falling back to the slower runner"
    warn "install it with: cargo install cargo-nextest --locked"
    cargo test "${PKGS[@]}" || fail "tests failed"
  fi

  # IPC bindings are generated, never hand-written (INV-10).
  say "IPC bindings"
  cargo run -q -p cogit --bin export-bindings || fail "could not export IPC bindings"
  if ! git diff --quiet -- "$BINDINGS"; then
    if [ "$FIX" = "1" ]; then
      git add -- "$BINDINGS"
      fixed "regenerated and staged $BINDINGS"
    else
      fail "$BINDINGS is stale; it was just regenerated — review and stage it"
    fi
  fi
fi

# --- frontend ----------------------------------------------------------------
if [ "$WEB" = "1" ]; then
  need npm
  say "svelte-check"
  npm --prefix frontend run --silent check || fail "type check failed"

  say "vitest"
  npm --prefix frontend run --silent test || fail "frontend tests failed"

  # An unbalanced <!-- leaves the comment body rendering as visible text, which
  # svelte-check accepts as a valid text node. Only what is being committed is checked.
  say "comment balance"
  for f in "${STAGED[@]}"; do
    case "$f" in
      *.svelte)
        [ -e "$f" ] || continue
        if [ "$(grep -c "<!--" "$f")" != "$(grep -c -- "-->" "$f")" ]; then
          fail "$f has unbalanced HTML comment markers"
        fi
        ;;
    esac
  done
fi

say "ok"
