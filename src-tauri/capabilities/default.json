{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main window and to the compare, merge and Investigate windows.",
  "windows": [
    "main",
    "compare-*",
    "merge-*",
    "investigate-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart"
  ]
}
