{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the main window and to its child windows.",
  "windows": [
    "main",
    "compare-*",
    "merge-*",
    "blame-*",
    "investigate-*",
    "commit-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "updater:default",
    "process:allow-restart"
  ]
}
