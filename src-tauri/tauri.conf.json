{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cogit",
  "identifier": "Cogit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cogit",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0f1115",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Blazing-fast Git GUI client for power users",
    "longDescription": "Cogit is a SmartGit-inspired Git client built with Rust and Tauri.",
    "publisher": "brano-san",
    "copyright": "Copyright (c) 2026 brano-san",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "linux/Cogit-alias.desktop",
        "files": {
          "/usr/share/applications/cogit.desktop": "linux/cogit.desktop",
          "/usr/share/icons/hicolor/16x16/apps/cogit.png": "icons/linux/hicolor/16x16/apps/cogit.png",
          "/usr/share/icons/hicolor/24x24/apps/cogit.png": "icons/linux/hicolor/24x24/apps/cogit.png",
          "/usr/share/icons/hicolor/32x32/apps/cogit.png": "icons/linux/hicolor/32x32/apps/cogit.png",
          "/usr/share/icons/hicolor/48x48/apps/cogit.png": "icons/linux/hicolor/48x48/apps/cogit.png",
          "/usr/share/icons/hicolor/64x64/apps/cogit.png": "icons/linux/hicolor/64x64/apps/cogit.png",
          "/usr/share/icons/hicolor/128x128/apps/cogit.png": "icons/linux/hicolor/128x128/apps/cogit.png",
          "/usr/share/icons/hicolor/256x256/apps/cogit.png": "icons/linux/hicolor/256x256/apps/cogit.png",
          "/usr/share/icons/hicolor/scalable/apps/cogit.svg": "icons/linux/hicolor/scalable/apps/cogit.svg"
        }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENUQwNTJEN0ZDMzU3N0EKUldSNlY4Ti9MUVZkTGNxdW9CSVJGOWZTNHFpYit4R2hlZXk3OVBLeFlaTTRmUVpWTnJhcEN6T1QK",
      "endpoints": [
        "https://github.com/brano-san/cogit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
