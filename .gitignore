# Rust
/target/
**/*.rs.bk
*.pdb

# Node
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Tauri
src-tauri/gen/
src-tauri/target/

# insta snapshot review leftovers
**/*.snap.new

# Agent worktrees and session scratch live here, not in the history.
.claude/

# IDE / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local environment
.env
.env.local

# `tauri icon` regenerates mobile assets; Cogit is desktop-only.
src-tauri/icons/android/
src-tauri/icons/ios/

# Stray downloads land here when a shell helper resolves its temp dir to an empty
# string: `cd ""` succeeds, so the fallback never runs and curl writes to the repo
# root. The project has no HTML at the top level, so this catches them.
/*.html

# The signing overlay names a certificate that lives on one machine; the example
# beside it is the tracked copy (13-distribution.md).
src-tauri/tauri.signing.conf.json
